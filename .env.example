# Par défaut, les signalements sont partagés en direct via ntfy.sh (aucune configuration).
# Canal ntfy utilisé (optionnel)
VITE_NTFY_TOPIC=affluence-grenoble-signalements-v1

# Optionnel : avec ces deux variables, l'app utilise Supabase à la place de ntfy
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
